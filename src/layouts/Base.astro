---
import '../styles/global.css';
import { site, enabledSections } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** Anchor links only work on the homepage; other pages link back to it. */
  home?: boolean;
}
const { title, description = site.description, home = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
const prefix = home ? '' : '/';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav>
      <div class="wrap">
        <a class="me" href="/">{site.name}</a>
        {enabledSections.map((s) => <a href={`${prefix}#${s.id}`}>{s.label}</a>)}
      </div>
    </nav>

    <slot />

    <footer>
      <div class="wrap">
        Built with Astro. Source on
        <a href="https://github.com/ProExpertProg/ProExpertProg.github.io">GitHub</a>.
      </div>
    </footer>
  </body>
</html>
